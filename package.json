{
  "name": "infinite-sudoku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "types:cloudflare": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv",
    "types:check": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --check",
    "lint": "eslint .",
    "test": "vitest run && npm run test:workers",
    "test:unit": "vitest run",
    "test:workers": "vitest run --config vitest.cloudflare.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "check": "npm run types:check && npm run lint -- --max-warnings=0 && npm run test:coverage && npm run test:workers && npm run build && npm run test:pwa",
    "preview": "vite preview",
    "dev:full": "wrangler pages dev -- vite"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/clerk-react": "^5.60.0",
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwindcss": "^4.1.18",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.3",
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.128.0"
  }
}
